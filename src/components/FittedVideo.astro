---
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
	/** Path under `public/`. */
	src: string
	poster: ImageMetadata
	width: number
	height: number
	label: string
	/**
	 * `ambient` loops silently like a moving photograph; `feature` is a film with sound that the
	 * visitor starts themselves.
	 */
	mode?: 'ambient' | 'feature'
	/** Vertical space around the video that must stay on screen with it, as a CSS length. */
	reserve?: string
	class?: string
}

const { src, poster, width, height, label, mode = 'feature', reserve = 'var(--header-h)', class: className } = Astro.props

const posterImage = await getImage({ src: poster, width: Math.min(poster.width, width), format: 'webp', quality: 72 })
const isAmbient = mode === 'ambient'
---

<div
	class:list={['fitted-video', className]}
	style={`--ratio: ${width / height}; --reserve: ${reserve}; aspect-ratio: ${width} / ${height};`}
>
	{
		isAmbient ? (
			<video
				src={src}
				poster={posterImage.src}
				width={width}
				height={height}
				autoplay
				muted
				loop
				playsinline
				disablepictureinpicture
				preload="auto"
				aria-label={label}
				data-ambient
			/>
		) : (
			<video
				src={src}
				poster={posterImage.src}
				width={width}
				height={height}
				controls
				playsinline
				preload="metadata"
				aria-label={label}
			/>
		)
	}
</div>

{
	isAmbient && (
		<script is:inline>
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.querySelectorAll('video[data-ambient]').forEach((video) => {
					video.removeAttribute('autoplay')
					video.pause()
				})
			}
		</script>
	)
}

<style>
	/*
	 * The box is as wide as it can be while its height, set by the aspect ratio, still fits the
	 * viewport minus the reserved space, so the whole frame is always visible without scrolling.
	 */
	.fitted-video {
		width: min(100%, calc((100vh - var(--reserve)) * var(--ratio)));
		width: min(100%, calc((100svh - var(--reserve)) * var(--ratio)));
		margin-inline: auto;
		background: var(--ink);
	}

	video {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
</style>

---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
	photo: ImageMetadata
	name: string
	role: string
	widths: number[]
	sizes: string
	/**
	 * `heading` makes the written name the card's heading, as on the home page. `decorative` hides it
	 * from assistive technology where a heading beside the photo already gives the name, as on About.
	 */
	nameAs?: 'heading' | 'decorative'
	/** Seconds before the name writes itself in, so a row of portraits writes one after another. */
	writeDelay?: number
	loading?: 'eager' | 'lazy'
	class?: string
}

const {
	photo,
	name,
	role,
	widths,
	sizes,
	nameAs = 'heading',
	writeDelay = 0.2,
	loading = 'lazy',
	class: className,
} = Astro.props
const isDecorative = nameAs === 'decorative'
---

{/* Name and role are live text over the photograph, not baked into it, so they stay sharp, translatable and readable by assistive technology. */}
<div class:list={['portrait', className]} style={`--write-delay: ${writeDelay}s`}>
	<Image src={photo} alt="" widths={widths} width={widths.at(-1)} quality={70} sizes={sizes} loading={loading} fetchpriority={loading === 'eager' ? 'high' : undefined} class="media-cover" />
	{
		isDecorative ? (
			<p class="name write-in" aria-hidden="true">
				{name}
			</p>
		) : (
			<h3 class="name write-in">{name}</h3>
		)
	}
	<p class="role" aria-hidden={isDecorative ? 'true' : undefined}>{role}</p>
</div>

<style>
	.portrait {
		position: relative;
		overflow: hidden;
		background: var(--sand);
		color: var(--cream);
	}

	/* Soft scrims keep cream type legible on the pale studio backdrop without darkening the subject. */
	.portrait::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to bottom, rgba(10, 10, 10, 0.42), rgba(10, 10, 10, 0) 32%),
			linear-gradient(to top, rgba(10, 10, 10, 0.5), rgba(10, 10, 10, 0) 28%);
		pointer-events: none;
	}

	.portrait :global(img) {
		transition: transform 0.9s var(--ease-out);
	}

	.portrait:hover :global(img) {
		transform: scale(1.04);
	}

	.name,
	.role {
		position: absolute;
		z-index: 1;
		left: clamp(14px, 5%, 24px);
		right: clamp(14px, 5%, 24px);
		text-align: var(--portrait-align, left);
		text-shadow: 0 1px 14px rgba(10, 10, 10, 0.35);
	}

	.name {
		top: clamp(20px, 7%, 40px);
		font: 400 var(--portrait-name-size, clamp(26px, 2.2vw, 36px)) / 1.05 var(--font-script);
	}

	.role {
		bottom: clamp(14px, 5%, 24px);
		font: 600 var(--portrait-role-size, clamp(9px, 0.8vw, 11px)) / 1.5 var(--font-sans);
		letter-spacing: var(--portrait-role-spacing, 0.2em);
		text-transform: uppercase;
	}
</style>

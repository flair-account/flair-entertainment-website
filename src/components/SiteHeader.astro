---
import { Image } from 'astro:assets'
import SiteMenu from '@/components/SiteMenu.astro'
import logo from '@/assets/brand/logo.png'
import logoCream from '@/assets/brand/logo-cream.png'
import { ENQUIRE_HREF, PRIMARY_NAV, SITE } from '@/data/site'

interface Props {
	/**
	 * `default` sits on paper above the page; `overlay` is drawn in cream over the home showreel,
	 * with the logo centred between the links and Enquire.
	 */
	variant?: 'default' | 'overlay'
}

const { variant = 'default' } = Astro.props
const isOverlay = variant === 'overlay'
const path = Astro.url.pathname
const isCurrent = (href: string): boolean => (href === '/' ? path === '/' : path.startsWith(href))
---

<header class:list={['site-header', `is-${variant}`]}>
	<a class="brand" href="/" aria-label={`${SITE.name} home`}>
		<Image
			src={isOverlay ? logoCream : logo}
			alt={SITE.name}
			height={isOverlay ? 64 : 54}
			densities={[1, 2]}
			loading="eager"
			fetchpriority={isOverlay ? undefined : 'high'}
		/>
	</a>
	<nav class="nav" aria-label="Primary">
		{
			PRIMARY_NAV.map((item) => (
				<a href={item.href} class="draw-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
	<a href={ENQUIRE_HREF} class="enquire" aria-current={isCurrent(ENQUIRE_HREF) ? 'page' : undefined}>Enquire</a>
	<div class="menu">
		<SiteMenu tone={isOverlay ? 'cream' : 'ink'} />
	</div>
</header>

<style>
	/* The header scrolls away with the page; it is deliberately not sticky. */
	.site-header {
		position: relative;
		z-index: 5;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 44px;
		padding: 28px var(--gutter);
	}

	.site-header a {
		color: inherit;
	}

	.brand {
		display: flex;
	}

	.brand :global(img) {
		width: auto;
		height: 54px;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 44px;
		font: 600 11px/1 var(--font-sans);
		letter-spacing: 0.28em;
		text-transform: uppercase;
	}

	.enquire {
		--sweep: var(--ink);
		--sweep-text: var(--paper);
		padding: 16px 28px;
		border: 1px solid currentColor;
		background: linear-gradient(var(--sweep), var(--sweep)) no-repeat left center / 0% 100%;
		font: 600 11px/1 var(--font-sans);
		letter-spacing: 0.28em;
		text-transform: uppercase;
		transition:
			background-size 0.5s var(--ease-in-out),
			color 0.35s ease 0.08s,
			border-color 0.35s ease;
	}

	.enquire:hover,
	.enquire[aria-current='page'] {
		opacity: 1;
		background-size: 100% 100%;
		border-color: var(--sweep);
		color: var(--sweep-text);
	}

	.menu {
		display: none;
	}

	/*
	 * Over the showreel: links left, logo centred, Enquire right, all in cream inside the hairline
	 * frame the home hero draws. Positioned against the page, which the hero starts.
	 */
	.is-overlay {
		position: absolute;
		top: var(--hero-inset);
		left: var(--hero-inset);
		right: var(--hero-inset);
		grid-template-columns: 1fr auto 1fr;
		padding: 24px clamp(20px, 2.4vw, 36px);
		color: var(--cream);
	}

	.is-overlay .brand {
		grid-column: 2;
		grid-row: 1;
	}

	.is-overlay .brand :global(img) {
		height: 64px;
	}

	.is-overlay .nav {
		grid-column: 1;
		grid-row: 1;
		justify-content: flex-start;
	}

	.is-overlay .enquire {
		--sweep: var(--cream);
		--sweep-text: var(--ink);
		justify-self: end;
		background-color: rgba(255, 255, 255, 0.06);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	@media (max-width: 860px) {
		.site-header {
			grid-template-columns: 1fr auto;
			padding-block: 16px;
		}

		.brand :global(img) {
			height: 40px;
		}

		.nav,
		.enquire {
			display: none;
		}

		.menu {
			display: block;
		}

		.is-overlay {
			grid-template-columns: 1fr auto 1fr;
			padding: 14px 16px;
		}

		.is-overlay .brand :global(img) {
			height: 44px;
		}

		.is-overlay .menu {
			grid-column: 3;
			grid-row: 1;
			justify-self: end;
		}
	}
</style>

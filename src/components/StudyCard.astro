---
import { Image } from 'astro:assets'
import type { CaseStudy } from '@/data/studies'

interface Props {
	study: CaseStudy
	/** Heading level, so the card fits the outline of the page it sits on. */
	level?: 'h2' | 'h3'
	/** Loaded with the page, so it sits above the fold and skips the scroll reveal. */
	eager?: boolean
	/** The first card is the page's largest paint on phones, so it is fetched ahead of the rest. */
	priority?: boolean
}

const { study, level: Heading = 'h2', eager = false, priority = false } = Astro.props
---

<a href={`/entertainment/${study.slug}/`} class="card">
	<div class:list={['frame', { reveal: !eager }]}>
		<Image
			src={study.cover}
			alt={study.coverAlt}
			widths={[360, 540, 720, 960]} width={960} quality={70}
			sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
			class="media-cover"
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={priority ? 'high' : undefined}
		/>
		<div class="veil" aria-hidden="true"><span>View <span class="arrow">&rarr;</span></span></div>
	</div>
	<div class="caption">
		<Heading class="title">{study.title}</Heading>
		<p class="eyebrow">{study.subtitle}</p>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 28px;
		color: var(--ink);
	}

	.card:hover {
		opacity: 1;
	}

	.frame {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--sand);
	}

	.frame :global(img) {
		transition: transform 0.9s var(--ease-out);
	}

	.card:hover .frame :global(img),
	.card:focus-visible .frame :global(img) {
		transform: scale(1.04);
	}

	.veil {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		padding: 28px;
		background: rgba(26, 26, 26, 0);
		transition: background 0.6s ease;
	}

	.veil > span {
		font: 600 10px/1 var(--font-sans);
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--paper);
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 0.5s ease,
			transform 0.6s var(--ease-out);
	}

	.veil .arrow {
		display: inline-block;
		margin-left: 6px;
		transition: transform 0.5s var(--ease-out) 0.1s;
	}

	.card:hover .veil > span,
	.card:focus-visible .veil > span {
		opacity: 1;
		transform: none;
	}

	.card:hover .veil .arrow,
	.card:focus-visible .veil .arrow {
		transform: translateX(4px);
	}

	.card:hover .veil,
	.card:focus-visible .veil {
		background: rgba(26, 26, 26, 0.18);
	}

	.caption {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.caption .eyebrow {
		letter-spacing: 0.3em;
	}
</style>

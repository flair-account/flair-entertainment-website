---
import { Image } from 'astro:assets'
import logoLight from '@/assets/brand/logo-light.png'
import { CAREERS_HREF, ENQUIRE_HREF, PRIMARY_NAV, SITE } from '@/data/site'

const year = new Date().getFullYear()
---

<footer class="site-footer on-dark">
	<div class="columns">
		<nav class="column" aria-label="Footer">
			<p class="label">Navigate</p>
			{PRIMARY_NAV.map((item) => <a class="draw-link" href={item.href}>{item.label}</a>)}
			<a class="draw-link" href={ENQUIRE_HREF}>Enquire</a>
			<a class="draw-link" href={CAREERS_HREF}>Careers as a performer</a>
		</nav>
		<div class="column">
			<p class="label">Follow us</p>
			<a class="draw-link" href={SITE.instagramUrl} rel="me noopener">Instagram</a>
			<a class="draw-link" href={SITE.facebookUrl} rel="me noopener">Facebook</a>
			<a class="draw-link email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
			<a class="draw-link phone" href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a>
		</div>
	</div>
	<div class="base">
		<Image src={logoLight} alt="" height={72} densities={[1, 2]} class="mark" />
		<p class="legal">
			Based in Jersey, Channel Islands · Working across the islands and the UK<br />
			Copyright {year} {SITE.name}. All rights reserved.
		</p>
	</div>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-direction: column;
		gap: 72px;
		padding: 96px var(--gutter) 40px;
		background: var(--ink);
		color: var(--cream);
	}

	.site-footer a {
		color: var(--cream);
	}

	.columns {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 64px;
	}

	.column {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 20px;
		font: 500 11px/1 var(--font-sans);
		letter-spacing: 0.28em;
		text-transform: uppercase;
	}

	.label {
		opacity: 0.5;
	}

	.email {
		margin-top: 8px;
		letter-spacing: 0.04em;
		text-transform: none;
	}

	.phone {
		letter-spacing: 0.12em;
	}

	.base {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 28px;
		text-align: center;
	}

	.mark {
		width: auto;
		height: 72px;
		opacity: 0.9;
	}

	.legal {
		font: 400 11px/1.8 var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.5;
	}
</style>

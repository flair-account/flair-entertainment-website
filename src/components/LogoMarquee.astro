---
import { Image } from 'astro:assets'
import { CLIENT_LOGOS } from '@/data/logos'
import type { ClientLogo } from '@/data/logos'

/**
 * Every logo gets the same area rather than the same height, so a long wordmark and a compact mark
 * carry similar visual weight. 6200px² is a 2:1 logo at about 111x56.
 */
const LOGO_AREA = 6200
/** Bounds that stop a very tall mark towering over the row or a very long one shrinking to a thread. */
const MIN_HEIGHT = 26
const MAX_HEIGHT = 68

const getLogoHeight = ({ image, weight = 1 }: ClientLogo): number => {
	const aspectRatio = image.width / image.height
	const height = Math.sqrt((LOGO_AREA * weight) / aspectRatio)
	return Math.round(Math.min(MAX_HEIGHT, Math.max(MIN_HEIGHT, height)))
}

/**
 * Copies of the set in each half of the looping track. One set of ten logos is roughly 1900px
 * wide, so two keep each half wider than a 2560px screen and the loop never shows a gap.
 */
const SETS_PER_HALF = 2

const logos = CLIENT_LOGOS.map((logo) => ({ ...logo, height: getLogoHeight(logo) }))
const sets = Array.from({ length: SETS_PER_HALF * 2 }, (_, index) => index)
---

<section class="trusted" aria-labelledby="trusted-heading">
	<h2 id="trusted-heading" class="eyebrow">Trusted by</h2>
	<div class="viewport">
		<ul class="track">
			{
				sets.map((set) =>
					logos.map((logo) => (
						<li aria-hidden={set > 0 ? 'true' : undefined}>
							<Image src={logo.image} alt={set > 0 ? '' : logo.name} height={logo.height} densities={[1, 2]} style={`height: ${logo.height}px`} />
						</li>
					)),
				)
			}
		</ul>
	</div>
</section>

<script>
	/** How long the strip takes to glide to a stop under the pointer, and to pick up speed again. */
	const EASE_MS = 900

	document.querySelectorAll<HTMLElement>('.trusted .viewport').forEach((viewport) => {
		// Absent when reduced motion turns the scroll off, which leaves nothing to slow down.
		const animation = viewport.querySelector('.track')?.getAnimations()[0]
		if (!animation) return
		let frame = 0

		const easeTo = (target: number): void => {
			cancelAnimationFrame(frame)
			const from = animation.playbackRate
			const start = performance.now()
			const step = (now: number): void => {
				const progress = Math.min(1, (now - start) / EASE_MS)
				const eased = 1 - (1 - progress) ** 3
				animation.playbackRate = from + (target - from) * eased
				if (progress < 1) frame = requestAnimationFrame(step)
			}
			frame = requestAnimationFrame(step)
		}

		viewport.addEventListener('pointerenter', (event) => event.pointerType === 'mouse' && easeTo(0))
		viewport.addEventListener('pointerleave', (event) => event.pointerType === 'mouse' && easeTo(1))
	})
</script>

<style>
	.trusted {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 40px;
		padding-block: 96px;
		border-block: 1px solid rgba(26, 26, 26, 0.08);
	}

	.viewport {
		width: 100%;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	/* Two identical runs scroll by exactly one run's width, so the loop has no visible seam. */
	.track {
		display: flex;
		align-items: center;
		gap: 72px;
		width: max-content;
		padding-right: 72px;
		/* About 45px a second across a half of two sets; scale it with SETS_PER_HALF or the logo count. */
		animation: scroll 84s linear infinite;
	}

	.track li {
		flex: none;
	}

	.track img {
		width: auto;
	}

	/* Without script the strip simply stops under the pointer; with it, it eases to a halt instead. */
	@media (scripting: none) {
		.viewport:hover .track {
			animation-play-state: paused;
		}
	}

	@keyframes scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			flex-wrap: wrap;
			justify-content: center;
			width: auto;
			padding-inline: var(--gutter);
			animation: none;
		}

		.track li[aria-hidden] {
			display: none;
		}
	}
</style>

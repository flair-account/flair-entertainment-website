---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import TeamPortrait from '@/components/TeamPortrait.astro'
import { CAREERS_HREF } from '@/data/site'
import { TEAM } from '@/data/team'
import culture from '@/assets/culture/culture.webp'

const CULTURE = [
	{
		heading: 'A message from Megan x',
		paragraphs: [
			'“Honestly, the culture at Flair is the thing I’m proudest of. It’s not something we tacked on later, it’s the whole reason any of this works.',
			'We’re really big on what we accept and what we tolerate, because what we accept, everyone accepts. What we celebrate, everyone celebrates. So we keep the bar high and we hold it there together.',
			'We work hard, we party hard, and when a big win comes in, we make a proper fuss of it. High standards, high celebration, and so much love for what we do and the people we get to do it with.”',
		],
	},
	{
		heading: 'Life inside Flair',
		paragraphs: [
			'“Everyone who joins Flair becomes part of the family and that’s the bit I love most.',
			'It’s the late nights and the loud playlists. The group chat that never really switches off in show season. Celebrating the big wins loud, and the little ones even louder. We’re a team of people who care so much about getting it right, and honestly, that’s exactly how we like it.”',
		],
	},
	{
		heading: 'Culture first, always',
		paragraphs: [
			'“We didn’t build a team to put on events.',
			'Instead, we built a culture and the events are what come out of it. The love is real, the standards are high, and the people are everything.”',
		],
	},
	{
		heading: 'Come join us',
		paragraphs: ['“We’re always on the lookout for brilliant, passionate people to come build something special with us.”'],
	},
] as const

const site = Astro.site ?? new URL('https://flairentertainment.je')
const aboutPage = {
	'@type': 'AboutPage',
	url: new URL('/about/', site).href,
	about: { '@id': `${site.href}#organization` },
	mainEntity: TEAM.map((member) => ({
		'@type': 'Person',
		name: member.name,
		jobTitle: member.fullRole,
		worksFor: { '@id': `${site.href}#organization` },
		sameAs: [member.linkedinUrl, member.instagramUrl].filter(Boolean),
	})),
}
---

<BaseLayout
	title="About Flair"
	description="Meet the team running Flair Entertainment: performers who have stood on the stage themselves, raising the standard of live entertainment in Jersey."
	image={culture}
	imageAlt="The Flair team lifting a performer in celebration"
	schema={[aboutPage]}
>
	<section class="intro section">
		<h1 class="display">Meet the team <span class="script">running flair</span></h1>
		<p class="mission">
			We exist to offer the finest entertainment experiences in Jersey, to raise standards, exceed expectations, and empower local performers to be
			the best they can be. Flair is more than a choreographed, costumed act: it is run by a team who have stood on the stage themselves.
		</p>
	</section>

	<section class="people section" aria-label="The team">
		{
			TEAM.map((member, index) => (
				<article class="person">
					<TeamPortrait
						photo={member.photo}
						name={member.name}
						role={member.role}
						widths={[320, 400, 640, 800]}
						sizes="(max-width: 700px) min(100vw, 320px), 400px"
						nameAs="decorative"
						loading={index === 0 ? 'eager' : 'lazy'}
						class="portrait reveal"
					/>
					<div class="bio">
						<p class="eyebrow">{member.fullRole}</p>
						<h2 class="title">{member.name}</h2>
						<p class="prose">{member.bio}</p>
						{(member.linkedinUrl || member.instagramUrl) && (
							<ul class="socials">
								{member.linkedinUrl && (
									<li>
										<a href={member.linkedinUrl} aria-label={`${member.name} on LinkedIn`} rel="noopener">
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M20.45 2H3.55C2.7 2 2 2.7 2 3.55v16.9C2 21.3 2.7 22 3.55 22h16.9c.85 0 1.55-.7 1.55-1.55V3.55C22 2.7 21.3 2 20.45 2ZM8.06 19.04H5.09V9.5h2.97v9.54ZM6.58 8.2a1.72 1.72 0 1 1 0-3.44 1.72 1.72 0 0 1 0 3.44Zm12.46 10.84h-2.96v-4.64c0-1.1-.02-2.53-1.54-2.53-1.55 0-1.78 1.2-1.78 2.45v4.72H9.8V9.5h2.84v1.3h.04c.4-.75 1.37-1.54 2.81-1.54 3 0 3.56 1.98 3.56 4.55v5.23Z" />
											</svg>
										</a>
									</li>
								)}
								{member.instagramUrl && (
									<li>
										<a href={member.instagramUrl} aria-label={`${member.name} on Instagram`} rel="noopener">
											<svg viewBox="0 0 24 24" aria-hidden="true" class="outline">
												<rect x="2.75" y="2.75" width="18.5" height="18.5" rx="5.25" />
												<circle cx="12" cy="12" r="4.25" />
												<circle cx="17.4" cy="6.6" r="0.6" class="dot" />
											</svg>
										</a>
									</li>
								)}
							</ul>
						)}
					</div>
				</article>
			))
		}
	</section>

	<section class="culture section" aria-labelledby="culture-heading">
		<div class="culture-image">
			<Image src={culture} alt="The Flair team lifting a performer in celebration, in black and white" widths={[480, 720, 960]} width={960} quality={70} sizes="(max-width: 900px) 100vw, 45vw" />
		</div>
		<div class="culture-copy">
			<h2 id="culture-heading" class="display">Company <span class="script">culture</span></h2>
			{
				CULTURE.map((block) => (
					<div class="culture-block">
						<h3 class="eyebrow">{block.heading}</h3>
						<div class="prose">
							{block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
						</div>
					</div>
				))
			}
			<a class="button" href={CAREERS_HREF}>Careers as a performer</a>
		</div>
	</section>
</BaseLayout>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 36px;
		padding-block: 112px 96px;
		text-align: center;
	}

	.mission {
		max-width: 760px;
		font: 500 12px/2 var(--font-sans);
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.people {
		display: flex;
		flex-direction: column;
		max-width: 1120px;
		margin-inline: auto;
		padding-bottom: 160px;
	}

	.person {
		display: grid;
		grid-template-columns: minmax(240px, 400px) minmax(0, 1fr);
		gap: 56px;
		align-items: start;
		padding-block: 56px;
		border-top: 1px solid rgba(26, 26, 26, 0.12);
	}

	.person :global(.portrait) {
		aspect-ratio: 6 / 7;
		--portrait-name-size: clamp(28px, 2.6vw, 38px);
	}

	.bio {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.bio .prose {
		display: block;
		margin-top: 8px;
	}

	.socials {
		display: flex;
		gap: 12px;
		margin: 8px 0 0 -8px;
	}

	/* A 48px target around a 30px glyph. */
	.socials a {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		color: var(--ink);
		transition:
			opacity 0.2s ease,
			transform 0.3s var(--ease-out);
	}

	.socials a:hover {
		opacity: 1;
		transform: translateY(-2px);
	}

	.socials svg {
		width: 30px;
		height: 30px;
		fill: currentColor;
	}

	.socials .outline {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.socials .outline .dot {
		fill: currentColor;
		stroke: none;
	}

	.culture {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 96px;
		align-items: start;
		padding-bottom: 180px;
	}

	.culture-image {
		position: sticky;
		top: 48px;
	}

	.culture-image img {
		width: 100%;
		filter: grayscale(1);
	}

	.culture-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 40px;
		max-width: 600px;
	}

	.culture-copy .display {
		font-size: clamp(28px, 3.6vw, 44px);
	}

	.culture-block {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.culture-block .eyebrow {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.culture {
			grid-template-columns: minmax(0, 1fr);
			gap: 56px;
			padding-bottom: 112px;
		}

		.culture-image {
			position: static;
		}
	}

	@media (max-width: 700px) {
		.intro {
			gap: 24px;
			padding-block: 72px 64px;
		}

		.person {
			grid-template-columns: minmax(0, 1fr);
			gap: 28px;
			padding-block: 40px;
		}

		/* Phones stack each person on a centred axis: portrait, then role, name, bio and links. */
		.person :global(.portrait) {
			--portrait-name-size: clamp(28px, 8vw, 36px);
			--portrait-role-size: 10px;
			--portrait-align: center;
			width: min(100%, 320px);
			margin-inline: auto;
		}

		.bio {
			align-items: center;
			text-align: center;
		}

		.socials {
			margin: 4px 0 0;
		}

		.mission {
			font-size: 11px;
			letter-spacing: 0.12em;
		}

		.people {
			padding-bottom: 96px;
		}
	}
</style>

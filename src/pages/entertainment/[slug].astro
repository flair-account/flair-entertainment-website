---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import FittedVideo from '@/components/FittedVideo.astro'
import { getThumbHashDataUrl } from '@/lib/getThumbHashDataUrl'
import EnquireBand from '@/components/EnquireBand.astro'
import { CASE_STUDIES, getNextStudy } from '@/data/studies'
import type { CaseStudy } from '@/data/studies'

interface Props {
	study: CaseStudy
}

export const getStaticPaths = (() =>
	CASE_STUDIES.map((study) => ({ params: { slug: study.slug }, props: { study } }))) satisfies GetStaticPaths

const { study } = Astro.props
const next = getNextStudy(study.slug)
const stillImage = study.heroImage ?? study.cover
const mediaRatio = study.video ? study.video.width / study.video.height : 2 / 3
const stillPlaceholder = study.video ? undefined : await getThumbHashDataUrl(stillImage)
const site = Astro.site ?? new URL('https://flairentertainment.je')

const breadcrumbs = {
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
		{ '@type': 'ListItem', position: 2, name: 'Entertainment', item: new URL('/entertainment/', site).href },
		{ '@type': 'ListItem', position: 3, name: study.headline, item: new URL(`/entertainment/${study.slug}/`, site).href },
	],
}
---

<BaseLayout
	title={`${study.headline}: ${study.subtitle}`}
	description={study.description}
	image={study.cover}
	imageAlt={study.coverAlt}
	type="article"
	schema={[breadcrumbs]}
>
	<article>
		<header class="hero section">
			<div class="media" style={`--media-ratio: ${mediaRatio}`}>
				{
					study.video ? (
						<FittedVideo {...study.video} reserve="calc(var(--header-h) + 96px)" />
					) : (
						<div class="still" style={stillPlaceholder ? `background-image: url(${stillPlaceholder})` : undefined}>
							<Image
								src={stillImage}
								alt={study.coverAlt}
								widths={[480, 720, 960]} width={960} quality={70}
								sizes="(max-width: 900px) 100vw, 45vw"
								loading="eager"
								fetchpriority="high"
							/>
						</div>
					)
				}
			</div>
			<div class="copy">
				<p class="eyebrow">Case study · {study.subtitle}</p>
				<h1 class="display">{study.headline}</h1>
				<span class="rule" aria-hidden="true"></span>
				<div class="prose">
					{study.body.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</div>
		</header>

		<section class="gallery section reveal-row" aria-label={`${study.headline} gallery`}>
			{
				study.gallery.map((item) => (
					<figure class="reveal">
						<Image
							src={item.image}
							alt={item.alt}
							widths={[400, 640, 960]} width={960} quality={70}
							sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
						/>
					</figure>
				))
			}
		</section>
	</article>

	<EnquireBand />

	<nav class="next section" aria-label="Next case study">
		<a href={`/entertainment/${next.slug}/`}>
			<span class="eyebrow">Next case study</span>
			<span class="title">{next.title}</span>
			<span class="eyebrow">{next.subtitle}</span>
			<span class="arrow" aria-hidden="true">→</span>
		</a>
	</nav>
</BaseLayout>

<style>
	/*
	 * Media and copy sit together as one centred group: a portrait film takes only the width its
	 * height allows instead of floating in half the page, and a landscape one stops at 55%.
	 */
	.hero {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: clamp(56px, 7vw, 112px);
		padding-block: 48px 140px;
	}

	/*
	 * The film stays in view while the story scrolls beside it. Top-aligned rather than centred, so
	 * the copy settling as web fonts load cannot move it.
	 */
	.media {
		position: sticky;
		top: calc(var(--header-h) + 8px);
		display: flex;
		flex: 0 1 calc((100svh - var(--header-h) - 96px) * var(--media-ratio));
		justify-content: center;
		min-width: 0;
		max-width: clamp(45%, calc(100% - 600px), 55%);
	}

	.still {
		width: min(100%, calc((100svh - var(--header-h) - 96px) * 2 / 3));
		background: var(--sand) center / cover no-repeat;
	}

	.still img {
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
	}

	.copy {
		display: flex;
		flex: 1 1 0;
		flex-direction: column;
		gap: 28px;
		max-width: 560px;
	}

	.copy .display {
		font-size: clamp(28px, 3.6vw, 44px);
	}

	.rule {
		width: 40px;
		height: 1px;
		background: var(--ink);
	}

	.gallery {
		columns: 3;
		column-gap: 16px;
		padding-bottom: 140px;
	}

	.gallery figure {
		margin-bottom: 16px;
		break-inside: avoid;
		background: var(--sand);
	}

	.gallery img {
		width: 100%;
	}

	.next a {
		display: grid;
		grid-template-columns: 1fr auto;
		row-gap: 16px;
		align-items: center;
		padding-block: 72px;
	}

	.next .eyebrow,
	.next .title {
		grid-column: 1;
	}

	.next .arrow {
		grid-column: 2;
		grid-row: 1 / span 3;
		font: 300 32px/1 var(--font-sans);
		transition: transform 0.5s var(--ease-out);
	}

	.next a:hover {
		opacity: 1;
	}

	.next a:hover .arrow,
	.next a:focus-visible .arrow {
		transform: translateX(8px);
	}

	@media (max-width: 1100px) {
		.gallery {
			columns: 2;
		}
	}

	@media (max-width: 900px) {
		.hero {
			flex-direction: column;
			gap: 56px;
			padding-block: 24px 96px;
		}

		.media {
			position: static;
			flex: none;
			width: 100%;
			max-width: none;
		}

		.copy {
			flex: none;
			max-width: none;
		}
	}

	@media (max-width: 700px) {
		.gallery {
			columns: 1;
			padding-bottom: 96px;
		}

		.next a {
			padding-block: 56px;
		}
	}
</style>

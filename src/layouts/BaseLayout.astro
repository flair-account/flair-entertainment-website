---
import '@/styles/global.css'
import Seo from '@/components/Seo.astro'
import type { SeoProps } from '@/components/Seo.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { SITE } from '@/data/site'

interface Props extends SeoProps {
	/** `overlay` draws the header in cream over a full-screen opening section, as on the home page. */
	headerVariant?: 'default' | 'overlay'
}

const { headerVariant = 'default', ...seo } = Astro.props
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/eyesome-script.woff2" as="font" type="font/woff2" crossorigin />
		<Seo {...seo} />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content={SITE.themeColor} />
		<meta name="format-detection" content="telephone=no" />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader variant={headerVariant} />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
		<script>
			/**
			 * Share of a heading that must be visible before its script word writes itself in. The heading
			 * is observed, not the word: a word clipped to nothing never counts as visible. A `.write-in`
			 * element is observed through its parent for the same reason.
			 */
			const WRITE_IN_THRESHOLD = 0.6

			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue
						entry.target.querySelectorAll('.script, .write-in').forEach((word) => word.classList.add('is-written'))
						observer.unobserve(entry.target)
					}
				},
				{ threshold: WRITE_IN_THRESHOLD }
			)

			document.querySelectorAll('.display:has(.script:not(.still, .still *))').forEach((heading) => observer.observe(heading))
			document.querySelectorAll('.write-in').forEach((word) => word.parentElement && observer.observe(word.parentElement))
		</script>
	</body>
</html>
